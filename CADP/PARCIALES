procedure procesar (l:lista; v2:vector; var v:vectorcompras);
var
min: real;
impares: integer;
clientemenor:integer;
dniact: integer;
gastototal:real;
begin
 min:=999999999;
 impares:=0;
 while (l <> nil) do begin 
  dniact:=l^.dato.dni;
  gastototal:=0 ;
  while (l <> nil) and (dniact=l^.dato.dni) do begin 
   gastototal:=gastototal + (l^.dato.kilos*v2 [l^.dato.cate].preciokilo);
   v[l^.dato.cate]:= v[l^.dato.cate]+1;
   if condicionimpar(l^.dato.dni) then 
    impares:=impares+1;
   l:=l^.sig;
   end;    
  if (gastototal<min) then begin
   min:= gastototal;
   clientemenor:= dniact;
   end;
  end;
 writeln ('el dni del cliente que menos ha gastado es...',clientemenor);
 vectorfinal (v);
 writeln ('la cantidad de compras hechas con gente con al menos 5 digitos del dni impares son...',impares);
 end;
 
