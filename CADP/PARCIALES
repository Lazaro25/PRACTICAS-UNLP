procedure agregaradelante (var l:lista; c:compras);
var
aux:lista;
begin 
  new (aux);
  aux^.dato:=c;
  aux^.sig:=l;
  l:=aux;
  end;
 

procedure cargarlista (var l:lista);
var
c:compras;
begin
 l:=nil;
 leerdatos (c);
 while (c.dni <> -1) do begin
  agregaradelante (l,c);
  leerdatos (c);
  end;
 end;
 
function condicionimpar (dni:integer ): boolean;
var
dig: integer;
impares:integer;
begin
 impares:=0;
 while (dni <> 0) do begin
 dig:=dni mod 10;
 if (dig mod 2 <> 0) then
  impares:= impares +1;
 dni:=dni div 10;
 end;
 condicionimpar:= (impares<=5); 
end;

procedure vectorfinal (v:vectorcompras);
var
i:integer;
begin
 for i:= 1 to 20 do begin 
  writeln ('la cantidad de compras de la categoria...',i,'...es...',v[i]);
