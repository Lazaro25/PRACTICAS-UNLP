 end;

procedure leer (var r:registro);
 begin
 writeln ('ingrese el nombre de la marca, ingrese "FIN" para cambiar de marca');
 readln (r.marca);
 writeln ('ingrese la linea de procesador');
 readln (r.linea);
 writeln ('ingrese la cantidad de cores');
 readln (r.cores);
 writeln ('ingrese la velocidad (en GHz');
 readln (r.velocidad);
 writeln ('por ultimo, ingrese el tamaño (en nanometros');
 readln (r.tamaño);
 end;
 
