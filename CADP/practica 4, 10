program lusmi;

type 
 vsalario = array [1..300] of real;

{-----------------------------------------------------------------------------------------------------------------------}
procedure inivector (var v:vsalario);
var
i: integer ;
begin 

 for i:= 1 to 300 do begin 
  v[i]:=0;
  end;
 end;
{-----------------------------------------------------------------------------------------------------------------------}  
procedure machirulo (var v:vsalario; var diml: integer);
 var
 salario:real;
 
 begin 
  diml:=0;
  writeln ('ingrese el salario del empleado numero...',diml+1);
  writeln ('RECUERDE QUE PARA FINALIZAR EL PROGRAMA, INGRESE SOLO EL NUMERO "0"');
  readln (salario);
  while (salario <> 0) and (diml<300) do begin 
   diml:=diml+1;
   v[diml]:= salario; 
   if diml<300 then begin  
    writeln ('ingrese el salario del empleado numero...',diml+1);
    readln (salario);
    end;
  end; 
 end; 
 
{----------------------------------------------------------------------------------------------------------------------} 
procedure aumento  (var v:vsalario; diml:integer; x:real);
var
i: integer;
begin 
 for i:= 1 to diml do begin
  v[i]:= v[i]*x;
  end;
 end;   
 
{---------------------------------------------------------------------------------------------------------------------} 
function calcularpromedio (v:vsalario; diml:integer):real;
var
i: integer;
suma:real;

begin 
suma:=0;
for i:= 1 to diml do begin 
 suma:= suma + v[i];
 end;
if diml>0 then 
 calcularpromedio:= suma / diml
else
 calcularpromedio:= 0;
end; 
{---------------------------------------------------------------------------------------------------------------------}   
var {PRINCIPAL}
 v:vsalario;
 diml:integer;
 x:real; 
begin 
 inivector (v);
 machirulo (v,diml);
 writeln ('ahora, escriba el porcentaje de aumento (si es del 15%, ingrese 1.15, si es del, 30%...1.30...');
 readln (x);
 if x>0 then
  aumento (v,diml,x);
 writeln ('el promedio general de salarios es....', calcularpromedio(v,diml));
 end.
 
 
 
